<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <SolidColorBrush x:Key="Shell" Color="#1B2027"/>
  <SolidColorBrush x:Key="Page" Color="#20262E"/>
  <SolidColorBrush x:Key="Surface" Color="#283039"/>
  <SolidColorBrush x:Key="ControlFill" Color="#323C48"/>
  <SolidColorBrush x:Key="Line" Color="#38434F"/>
  <SolidColorBrush x:Key="Ink" Color="#EDF1F5"/>
  <SolidColorBrush x:Key="Muted" Color="#B6C2CF"/>
  <SolidColorBrush x:Key="Accent" Color="#8AC5EF"/>
  <SolidColorBrush x:Key="RecordBackground" Color="#213A4B"/>
  <SolidColorBrush x:Key="OverlayEdge" Color="#142634"/>
  <Style TargetType="TextBlock"><Setter Property="VerticalAlignment" Value="Center"/></Style>
  <Style x:Key="Heading" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
    <Setter Property="FontSize" Value="22"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Margin" Value="0,0,0,14"/>
  </Style>
  <Style x:Key="SectionTitle" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
    <Setter Property="FontSize" Value="15"/><Setter Property="FontWeight" Value="SemiBold"/>
  </Style>
  <Style x:Key="Hint" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
    <Setter Property="FontSize" Value="12"/><Setter Property="Foreground" Value="{StaticResource Muted}"/>
    <Setter Property="TextWrapping" Value="Wrap"/><Setter Property="LineHeight" Value="18"/>
  </Style>
  <Style x:Key="Glyph" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
    <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/><Setter Property="FontSize" Value="17"/>
    <Setter Property="Width" Value="22"/><Setter Property="TextAlignment" Value="Center"/><Setter Property="Margin" Value="0,0,10,0"/>
  </Style>
  <Style x:Key="Card" TargetType="Border">
    <Setter Property="Background" Value="{StaticResource Surface}"/><Setter Property="BorderBrush" Value="{StaticResource Line}"/>
    <Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="9"/>
    <Setter Property="Padding" Value="18,13"/><Setter Property="Margin" Value="0,0,0,12"/>
  </Style>
  <Style TargetType="Button">
    <Setter Property="Foreground" Value="{StaticResource Ink}"/><Setter Property="Background" Value="{StaticResource ControlFill}"/>
    <Setter Property="BorderBrush" Value="#475462"/><Setter Property="BorderThickness" Value="1"/>
    <Setter Property="Padding" Value="12,5"/><Setter Property="MinHeight" Value="32"/>
    <Setter Property="Cursor" Value="Hand"/><Setter Property="HorizontalContentAlignment" Value="Center"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
      <Grid><Border x:Name="Base" CornerRadius="6" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"/>
        <Border x:Name="Hover" Background="White" CornerRadius="6" Opacity="0" IsHitTestVisible="False"/>
        <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center" RecognizesAccessKey="True"/>
      </Grid>
      <ControlTemplate.Triggers>
        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Hover" Property="Opacity" Value=".065"/></Trigger>
        <Trigger Property="IsPressed" Value="True"><Setter TargetName="Hover" Property="Opacity" Value=".12"/></Trigger>
        <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Base" Property="BorderBrush" Value="{StaticResource Accent}"/></Trigger>
        <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value=".50"/></Trigger>
      </ControlTemplate.Triggers>
    </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="Primary" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
    <Setter Property="Background" Value="{StaticResource Accent}"/><Setter Property="Foreground" Value="#0E1A22"/>
    <Setter Property="BorderBrush" Value="{StaticResource Accent}"/><Setter Property="FontWeight" Value="SemiBold"/>
  </Style>
  <Style x:Key="Ghost" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
    <Setter Property="Background" Value="Transparent"/><Setter Property="BorderBrush" Value="Transparent"/>
    <Setter Property="Padding" Value="8,3"/><Setter Property="MinHeight" Value="28"/>
  </Style>
  <Style x:Key="KeyButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
    <Setter Property="FontFamily" Value="Segoe UI, Microsoft YaHei UI"/><Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="Padding" Value="9,3"/>
  </Style>
  <Style x:Key="OverlayCloseButton" TargetType="Button" BasedOn="{StaticResource Ghost}">
    <Style.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#B42631"/></Trigger></Style.Triggers>
  </Style>
  <Style x:Key="Nav" TargetType="RadioButton">
    <Setter Property="Margin" Value="0,2"/><Setter Property="Foreground" Value="{StaticResource Ink}"/><Setter Property="Cursor" Value="Hand"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RadioButton">
      <Border x:Name="Tab" CornerRadius="7" Background="Transparent">
        <Grid Height="39"><Border x:Name="Mark" Width="3" Height="16" HorizontalAlignment="Left" VerticalAlignment="Center" CornerRadius="2"/>
          <ContentPresenter Margin="11,0,7,0" VerticalAlignment="Center"/></Grid>
      </Border>
      <ControlTemplate.Triggers>
        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Tab" Property="Background" Value="#262F39"/></Trigger>
        <Trigger Property="IsChecked" Value="True"><Setter TargetName="Tab" Property="Background" Value="#2B3948"/><Setter TargetName="Mark" Property="Background" Value="{StaticResource Accent}"/></Trigger>
        <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Tab" Property="BorderBrush" Value="{StaticResource Accent}"/><Setter TargetName="Tab" Property="BorderThickness" Value="1"/></Trigger>
      </ControlTemplate.Triggers>
    </ControlTemplate></Setter.Value></Setter>
  </Style>

  <Style TargetType="TextBox">
    <Setter Property="Padding" Value="10,5"/><Setter Property="VerticalContentAlignment" Value="Center"/>
    <Setter Property="Foreground" Value="{StaticResource Ink}"/><Setter Property="CaretBrush" Value="White"/><Setter Property="SelectionBrush" Value="#397DAB"/>
    <Setter Property="Background" Value="{StaticResource Page}"/><Setter Property="BorderBrush" Value="#495868"/><Setter Property="MinHeight" Value="34"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TextBox">
      <Grid><Border x:Name="InputBorder" Background="{TemplateBinding Background}" CornerRadius="6" BorderThickness="1" BorderBrush="{TemplateBinding BorderBrush}"/>
        <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" VerticalAlignment="Center"/>
      </Grid><ControlTemplate.Triggers><Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="InputBorder" Property="BorderBrush" Value="{StaticResource Accent}"/></Trigger></ControlTemplate.Triggers>
    </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="Watermark" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
    <Setter Property="IsHitTestVisible" Value="False"/><Setter Property="Margin" Value="11,0,8,0"/><Setter Property="Foreground" Value="{StaticResource Muted}"/><Setter Property="TextTrimming" Value="CharacterEllipsis"/>
  </Style>
  <Style x:Key="SliderRail" TargetType="RepeatButton">
    <Setter Property="Focusable" Value="False"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RepeatButton">
      <Grid Background="Transparent"><Border Background="{TemplateBinding Background}" Height="3" CornerRadius="2" VerticalAlignment="Center"/></Grid>
    </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="Slider">
    <Setter Property="IsMoveToPointEnabled" Value="True"/><Setter Property="Height" Value="24"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Slider">
      <Grid Background="Transparent"><Track x:Name="PART_Track" VerticalAlignment="Center" Height="20">
        <Track.DecreaseRepeatButton><RepeatButton Style="{StaticResource SliderRail}" Background="{StaticResource Accent}" Command="{x:Static Slider.DecreaseLarge}"/></Track.DecreaseRepeatButton>
        <Track.Thumb><Thumb Width="15" Height="15"><Thumb.Template><ControlTemplate TargetType="Thumb"><Ellipse Fill="{StaticResource Accent}" Stroke="{StaticResource Surface}" StrokeThickness="2"/></ControlTemplate></Thumb.Template></Thumb></Track.Thumb>
        <Track.IncreaseRepeatButton><RepeatButton Style="{StaticResource SliderRail}" Background="#566573" Command="{x:Static Slider.IncreaseLarge}"/></Track.IncreaseRepeatButton>
      </Track></Grid><ControlTemplate.Triggers><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value=".45"/></Trigger></ControlTemplate.Triggers>
    </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="ScrollPart" TargetType="RepeatButton">
    <Setter Property="Focusable" Value="False"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RepeatButton"><Border Background="Transparent"/></ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="ScrollBar">
    <Setter Property="Width" Value="12"/><Setter Property="Height" Value="Auto"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ScrollBar">
      <Grid Background="Transparent"><Track x:Name="PART_Track" IsDirectionReversed="True" Orientation="{TemplateBinding Orientation}">
        <Track.DecreaseRepeatButton><RepeatButton x:Name="Less" Command="{x:Static ScrollBar.PageUpCommand}" Style="{StaticResource ScrollPart}"/></Track.DecreaseRepeatButton>
        <Track.Thumb><Thumb x:Name="Handle" MinHeight="16" Margin="3,1"><Thumb.Template><ControlTemplate TargetType="Thumb"><Border CornerRadius="3" Background="#858585"/></ControlTemplate></Thumb.Template></Thumb></Track.Thumb>
        <Track.IncreaseRepeatButton><RepeatButton x:Name="More" Command="{x:Static ScrollBar.PageDownCommand}" Style="{StaticResource ScrollPart}"/></Track.IncreaseRepeatButton>
      </Track></Grid><ControlTemplate.Triggers><Trigger Property="Orientation" Value="Horizontal">
        <Setter Property="Width" Value="Auto"/><Setter Property="Height" Value="12"/><Setter TargetName="PART_Track" Property="IsDirectionReversed" Value="False"/>
        <Setter TargetName="Handle" Property="Margin" Value="1,3"/><Setter TargetName="Handle" Property="MinHeight" Value="0"/><Setter TargetName="Handle" Property="MinWidth" Value="16"/>
        <Setter TargetName="Less" Property="Command" Value="{x:Static ScrollBar.PageLeftCommand}"/><Setter TargetName="More" Property="Command" Value="{x:Static ScrollBar.PageRightCommand}"/>
      </Trigger></ControlTemplate.Triggers>
    </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="EpisodeRow" TargetType="ListBoxItem">
    <Setter Property="Foreground" Value="{StaticResource Ink}"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/>
    <Setter Property="Padding" Value="10,7"/><Setter Property="Cursor" Value="Hand"/><Setter Property="ToolTip" Value="{Binding Title}"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem">
      <Grid><Border x:Name="Row" CornerRadius="4" Background="Transparent"/><Border x:Name="Indicator" Width="3" Height="15" HorizontalAlignment="Left" VerticalAlignment="Center" CornerRadius="2"/>
        <ContentPresenter Margin="{TemplateBinding Padding}"/></Grid>
      <ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Row" Property="Background" Value="#323C48"/></Trigger>
        <Trigger Property="IsSelected" Value="True"><Setter TargetName="Row" Property="Background" Value="#35495B"/><Setter TargetName="Indicator" Property="Background" Value="{StaticResource Accent}"/></Trigger>
      </ControlTemplate.Triggers>
    </ControlTemplate></Setter.Value></Setter>
  </Style>
</ResourceDictionary>
